{
  "name": "@smplcty/auth",
  "version": "11.1.0",
  "description": "Robust, type-safe session and role-based authentication primitives for PostgreSQL apps using Row-Level Security.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./oidc": {
      "types": "./dist/methods/oidc/index.d.ts",
      "import": "./dist/methods/oidc/index.js",
      "default": "./dist/methods/oidc/index.js"
    },
    "./twilio": {
      "types": "./dist/methods/twilio/index.d.ts",
      "import": "./dist/methods/twilio/index.js",
      "default": "./dist/methods/twilio/index.js"
    },
    "./email-code": {
      "types": "./dist/methods/email-code/index.d.ts",
      "import": "./dist/methods/email-code/index.js",
      "default": "./dist/methods/email-code/index.js"
    },
    "./flat-tenant": {
      "types": "./dist/scope/flat-tenant.d.ts",
      "import": "./dist/scope/flat-tenant.js",
      "default": "./dist/scope/flat-tenant.js"
    },
    "./email-domains": {
      "types": "./dist/email-domains/index.d.ts",
      "import": "./dist/email-domains/index.js",
      "default": "./dist/email-domains/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mabulu-inc/simplicity-auth.git"
  },
  "homepage": "https://github.com/mabulu-inc/simplicity-auth#readme",
  "bugs": {
    "url": "https://github.com/mabulu-inc/simplicity-auth/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "session",
    "auth",
    "authentication",
    "authorization",
    "multi-tenant"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "oxlint src tests",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm build && pnpm test",
    "prepare": "husky",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it",
    "release:patch": "GITHUB_TOKEN=$(gh auth token) release-it patch",
    "release:minor": "GITHUB_TOKEN=$(gh auth token) release-it minor",
    "release:major": "GITHUB_TOKEN=$(gh auth token) release-it major"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@smplcty/schema-flow": ">=0.25.0",
    "@smplcty/twilio": ">=0.1.0",
    "oauth4webapi": ">=3.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@smplcty/twilio": {
      "optional": true
    },
    "oauth4webapi": {
      "optional": true
    },
    "@smplcty/schema-flow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "@smplcty/schema-flow": "^0.26.0",
    "@smplcty/twilio": "^0.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "jose": "^6.2.14",
    "lint-staged": "^17.6.0",
    "oauth4webapi": "^3.8.8",
    "oxlint": "^1.90.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@smplcty/db": "^4.3.0",
    "@smplcty/schema-std": "^0.1.0",
    "otplib": "^13.6.0"
  }
}
